{
  "allowOnDemand": true,
  "displayName": "OTX Ingestion",
  "features": [
    "aotExecutionEnabled",
    "appBuilderCompliant",
    "fileParams"
  ],
  "feeds": [
    {
      "documentStorageLimitMb": 100,
      "enableBulkJson": false,
      "indicatorLimit": 5000000,
      "jobFile": "otx-ingestion.json",
      "sourceCategory": "Public",
      "sourceDescription": "This app allows the ingestion of the OTX Feed into the ThreatConnect Platform.",
      "sourceName": "OTX Feed"
    }
  ],

  "labels": [],
  "languageVersion": "3.11",
  "listDelimiter": "|",
  "note": "Ingest OTX Feed into ThreatConnect.",
  "params": [
    {
      "label": "ThreatConnect Owner",
      "name": "tc_owner",
      "note": "The destination Owner in the ThreatConnect Platform.",
      "required": true,
      "sequence": 1,
      "type": "Choice",
      "validValues": [
        "${OWNERS}"
      ]
    },
    {
      "label": "OTX API Key",
      "name": "otx_api_key",
      "note": "API key for AlienVault OTX. Required for authenticated requests to the OTX API.",
      "required": true,
      "sequence": 2,
      "type": "String"
      ,"validValues": [
        "${KEYCHAIN}",
        "${TEXT}"
      ]
    },
    {
      "default": "30 Days Ago",
      "label": "Last Run",
      "name": "last_run",
      "note": "Initial value: \"N Days Ago\" (e.g. \"7 Days Ago\") or an ISO date/datetime. Persisted after each run for incremental sync.",
      "required": false,
      "sequence": 3,
      "type": "String"
    },
    {
      "default": "warning",
      "label": "Logging Level",
      "name": "tc_log_level",
      "sequence": 99,
      "type": "Choice",
      "validValues": [
        "debug",
        "info",
        "warning",
        "error"
      ]
    }
  ],
  "programLanguage": "PYTHON",
  "programMain": "run.py",
  "programVersion": "1.0.0",
  "runtimeLevel": "Organization",
  "sdkVersion": "4.0.0"
}
